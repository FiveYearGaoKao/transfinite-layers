{
  "name": "transfinitelayers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:beta": "node -e \"require('fs').rmSync('dist/beta',{recursive:true,force:true})\" && run-p type-check \"build-only:beta {@}\" --",
    "build-only:beta": "vite build --mode beta --outDir dist/beta",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "check": "run-s check:pricing check:effects check:save check:achievements check:meta",
    "check:pricing": "node scripts/run-ts.mjs scripts/checkPricing.ts",
    "check:effects": "node scripts/run-ts.mjs scripts/checkEffects.ts",
    "check:save": "node scripts/run-ts.mjs scripts/checkSave.ts",
    "check:achievements": "node scripts/run-ts.mjs scripts/checkAchievements.ts",
    "check:meta": "node scripts/run-ts.mjs scripts/checkMetaDimension.ts",
    "sim": "node scripts/run-ts.mjs scripts/sim.ts"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.2",
    "lz-string": "^1.5.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "~10.4.0",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vue-tsc": "^3.1.0"
  }
}
